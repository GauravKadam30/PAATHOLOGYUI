# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Generated per-OS — committing it caused native-binary mismatches across
# Windows/Linux. Each machine creates its own on `npm install`.
package-lock.json

# Local environment files — these hold the database password and SMTP
# credentials. apps/server/.env.example documents every value without them.
.env

# Runtime data, not source: uploaded whole-slide files (many GB each) and the
# pg_dump snapshots taken at startup and daily.
apps/server/uploads
apps/server/backups

# Python bytecode cache, generated by tools/tile_server.py on first run
__pycache__
*.pyc

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
