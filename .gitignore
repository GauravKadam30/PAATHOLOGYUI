# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Generated per-OS — committing it caused native-binary mismatches across
# Windows/Linux. Each machine creates its own on `npm install`.
package-lock.json

# Backend data store (created at runtime) and local env files
data.json
data.json.migrated
data.db
data.db-wal
data.db-shm
.env

# Uploaded whole-slide files (can run to many GB) and backup dumps —
# runtime data, not source. Same reasoning as data.db above.
apps/server/uploads
apps/server/backups

# Python bytecode cache, generated by tools/tile_server.py on first run
__pycache__
*.pyc

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
