# Backend configuration — copy to `.env` and edit. Every value is optional:
# with no .env at all the server runs on SQLite with sensible local defaults.
#
# `.env` itself is gitignored, so real credentials never reach the repository.

# --- Database ----------------------------------------------------------------
# LEAVE THIS UNSET to use the built-in SQLite file (apps/server/data.db) — that
# is the zero-setup default and needs nothing installed.
#
# SET IT to switch the whole backend to PostgreSQL. Both are fully supported;
# the driver is chosen at startup purely by whether this variable is present.
# Existing SQLite data can be copied across first with:
#   node tools/migrate-sqlite-to-postgres.js --dry-run
#   node tools/migrate-sqlite-to-postgres.js
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/telepathology

# Where the SQLite file lives (ignored when DATABASE_URL is set).
# DB_FILE=./data.db

# --- Server ------------------------------------------------------------------
# PORT=3001
# TILE_PORT=5001

# Signing key for login tokens. REQUIRED when NODE_ENV=production — the server
# refuses to start without it there, rather than silently using a key that is
# published in this repository. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=

# Comma-separated CORS allow-list. Unset means "allow any origin", which is
# convenient locally and wrong anywhere else.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Whole-slide images ------------------------------------------------------
# Where uploaded scanner files are stored. These can run to many GB per slide,
# so point this at a disk with room.
# UPLOADS_DIR=./uploads

# Python interpreter used for the OpenSlide tile service (needs `openslide-bin`
# and `Pillow` installed). Set this if `python` is not the right one on PATH.
# PYTHON=python

# --- Backups -----------------------------------------------------------------
# A snapshot is taken at startup and then on an interval. On PostgreSQL this
# shells out to pg_dump; set PG_DUMP if it is not on PATH (the Windows
# installer does not add it).
# BACKUP_DIR=./backups
# BACKUP_KEEP=7
# BACKUP_INTERVAL_MS=86400000
# PG_DUMP=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe

# --- Email (password reset codes) --------------------------------------------
# Unset means reset codes are PRINTED TO THE SERVER CONSOLE instead of emailed,
# which is what you want for local development. Fill these in to send for real.
# For Gmail, SMTP_PASS must be a 16-character App Password, not the account
# password — https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=
# MAIL_FROM="EPTB Hub <you@example.com>"
