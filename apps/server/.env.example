# Backend configuration — copy to `.env` and edit.
#
# `.env` itself is gitignored, so real credentials never reach the repository.
# DATABASE_URL is the only REQUIRED value; everything else has a sensible
# local default and can stay commented out.

# --- Database (required) -----------------------------------------------------
# PostgreSQL connection string. The server refuses to start without it rather
# than guessing, so a misconfigured environment fails immediately instead of
# part-way through the first request.
#
# Create the database once with:
#   psql -U postgres -c "CREATE DATABASE telepathology"
# Tables are created automatically on first boot, so there is no migration step.
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/telepathology

# Used only by `npm test`. Leave it unset and the suite derives its own name by
# appending _test to the database above, creating it if needed. It refuses to
# run against the same database as DATABASE_URL either way.
# TEST_DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/telepathology_test

# --- Server ------------------------------------------------------------------
# PORT=3001
# TILE_PORT=3002

# Signing key for login tokens. REQUIRED when NODE_ENV=production — the server
# refuses to start without it there, rather than silently using a key that is
# published in this repository. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=

# Comma-separated CORS allow-list. Unset means "allow any origin", which is
# convenient locally and wrong anywhere else.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Whole-slide images ------------------------------------------------------
# Where uploaded scanner files are stored. These can run to many GB per slide,
# so point this at a disk with room.
# UPLOADS_DIR=./uploads

# Python interpreter used for the OpenSlide tile service. It needs three
# packages: `openslide-bin` (the compiled C library), `openslide-python` (the
# binding that provides `import openslide`) and `Pillow` (tile encoding).
# Installing only openslide-bin fails later with ModuleNotFoundError.
# Set this if `python` is not the right one on PATH.
# PYTHON=python

# --- Backups -----------------------------------------------------------------
# A snapshot is taken at startup and then on an interval, using pg_dump. Set
# PG_DUMP if it is not on PATH — the Windows installer does not add it.
# BACKUP_DIR=./backups
# BACKUP_KEEP=7
# BACKUP_INTERVAL_MS=86400000
# PG_DUMP=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe

# --- Email (password reset codes) --------------------------------------------
# Unset means reset codes are PRINTED TO THE SERVER CONSOLE instead of emailed,
# which is what you want for local development. Fill these in to send for real.
# For Gmail, SMTP_PASS must be a 16-character App Password, not the account
# password — https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=
# MAIL_FROM="EPTB Hub <you@example.com>"
