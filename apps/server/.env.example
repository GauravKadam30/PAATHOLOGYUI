# Copy this file to `.env` in this same folder (apps/server/.env) and fill in
# real values. `.env` is gitignored — nothing here ever gets committed.
#
# Everything below is OPTIONAL. With no .env file at all, the server runs
# exactly as it always has: password-reset codes print to this console
# instead of being emailed. Add these once you want real emails sent.

# --- Email (password reset codes) -------------------------------------------
# Any SMTP-compatible provider works — Gmail, Outlook/Microsoft 365, a
# transactional API (Resend, SendGrid, Mailgun, Postmark, ...), or a mail
# server you already run. All of them speak SMTP, so only these values change
# between providers; the code sending the email is the same either way.
#
# Gmail example (needs 2-Step Verification turned on first):
#   1. Go to https://myaccount.google.com/apppasswords
#   2. Create an app password for "Mail"
#   3. Use that 16-character password as SMTP_PASS below — NOT your normal
#      Google account password, which won't work here.
#
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=your-16-character-app-password
#   MAIL_FROM=youraddress@gmail.com
#
# A transactional provider (e.g. Resend) looks the same, just with their SMTP
# host/credentials from their dashboard instead:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASS=your-api-key
#   MAIL_FROM=noreply@yourdomain.com

SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=true      # uncomment only if your provider needs port 465 (implicit TLS)
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Everything else the server reads from the environment ------------------
# (all optional; shown here for reference, not required to run locally)
# PORT=3001
# TILE_PORT=3002
# JWT_SECRET=            # required once NODE_ENV=production
# ALLOWED_ORIGINS=       # comma-separated list of allowed frontend origins
